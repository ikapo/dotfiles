# Ghostty reads this file directly (stow links ~/.config/ghostty here) and
# reloads it live on save.
font-family = Mononoki Nerd Font Mono
font-size = 22
background = #000000

# 0.85 opacity (Ghostty's scale is 1.0 = opaque), 15% transparent, blur off.
background-opacity = 0.85

# A bit more breathing room than Ghostty's tight default of 2.
window-padding-x = 10
window-padding-y = 10
# New windows and tabs start in ~ instead of the focused terminal's directory
# (Ghostty inherits it by default). Splits still inherit.
working-directory = home
window-inherit-working-directory = false
tab-inherit-working-directory = false

clipboard-read = allow
clipboard-write = allow

# zsh owns the cursor shape (bar in vi insert mode, block in normal mode), so
# keep Ghostty's shell integration from setting it as well.
shell-integration-features = no-cursor

# Default to a blinking bar for programs that don't pick a cursor shape
# themselves (Claude Code, less, ...) and for zsh's preexec reset.
cursor-style = bar

# Option+Backspace deletes a word. Option isn't Alt here (macos-option-as-alt
# is off so Option still types special characters), so send the ESC+DEL that
# shells and Claude Code read as meta-backspace.
keybind = alt+backspace=text:\x1b\x7f
