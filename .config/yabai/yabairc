yabai -m config layout bsp

yabai -m space 1 --label one
yabai -m space 2 --label two
yabai -m space 3 --label three
yabai -m space 4 --label four
yabai -m space 5 --label five
yabai -m space 6 --label six
yabai -m space 7 --label seven
yabai -m space 8 --label eight
yabai -m space 9 --label nine

# float system preferences. Most of these just diable Yabai form resizing them.
# sticky and sub-layer need the scripting addition (SIP partly disabled; see
# yabai(1) RULE). SIP is on here, so they sit in comments: move them back into
# the rules if SIP is ever relaxed.
yabai -m rule --add app="^System Settings$" manage=off # sticky=on sub-layer=above
yabai -m rule --add app="^Finder$" manage=off # sticky=on sub-layer=above
yabai -m rule --add app="^Disk Utility$" manage=off # sticky=on sub-layer=above
yabai -m rule --add app="^System Information$" manage=off # sticky=on sub-layer=above
yabai -m rule --add app="^Activity Monitor$" manage=off # sticky=on sub-layer=above
yabai -m rule --add app="^Streaks$" manage=off

yabai -m config top_padding 2
yabai -m config bottom_padding 2
yabai -m config left_padding 2
yabai -m config right_padding 2
yabai -m config window_gap 10

# Closing an app's last window (alt-q, cmd-w, exit) leaves nothing focused;
# hand focus to another window on the same display.
yabai -m signal --add label=focus_after_close event=window_destroyed active=yes action="$HOME/.local/bin/focus-after-close.sh"
yabai -m signal --add label=focus_after_quit event=application_terminated action="$HOME/.local/bin/focus-after-close.sh"
