#!/usr/bin/env python3
"""Sync .config/ai into Claude Code, Codex, and Zed."""

import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

VERSION = "ai-sync 1.0"

USAGE = """usage: ai-sync [--check] [--version] [--help]

Sync ~/.config/ai into Claude Code, Codex, and Zed.

  (no flags)  apply all changes; idempotent
  --check     report what would change; exit 1 on drift, 0 when clean
  --version   print version
  --help      print this message

Source of truth: ~/.config/ai
  AGENTS.md            shared instructions
  mcp.json             MCP server definitions
  skills/              personal skills
  claude/settings.json Claude Code settings"""

VALID_TARGETS = {"claude", "zed", "codex"}


class ConfigError(Exception):
    """Raised when mcp.json is unusable. Message may be multi-line."""


def repo_root() -> Path:
    override = os.environ.get("AI_SYNC_REPO")
    if override:
        return Path(override)
    return Path(__file__).resolve().parents[2]


def target_home() -> Path:
    override = os.environ.get("AI_SYNC_HOME")
    if override:
        return Path(override)
    return Path.home()


def ai_dir() -> Path:
    return repo_root() / ".config" / "ai"


def load_servers(directory: Path) -> dict:
    path = directory / "mcp.json"
    try:
        raw = path.read_text()
    except OSError as exc:
        raise ConfigError("cannot read %s: %s" % (path, exc)) from exc
    try:
        data = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise ConfigError("%s is not valid JSON: %s" % (path, exc)) from exc

    if not isinstance(data, dict):
        raise ConfigError("%s: top level must be an object" % path)
    servers = data.get("servers", {})
    if not isinstance(servers, dict):
        raise ConfigError("%s: 'servers' must be an object" % path)

    valid = ", ".join(sorted(VALID_TARGETS))
    errors = []
    for name, cfg in servers.items():
        if not isinstance(cfg, dict):
            errors.append("%s: must be an object" % name)
            continue
        if not cfg.get("command"):
            errors.append("%s: missing 'command'" % name)
        elif not isinstance(cfg["command"], str):
            errors.append("%s: 'command' must be a string" % name)
        targets = cfg.get("targets")
        if not targets:
            errors.append("%s: missing 'targets' (valid: %s)" % (name, valid))
            continue
        if not isinstance(targets, list):
            errors.append("%s: 'targets' must be a list (valid: %s)" % (name, valid))
            continue
        unknown = sorted(set(targets) - VALID_TARGETS)
        if unknown:
            errors.append(
                "%s: unknown target(s) %s (valid: %s)"
                % (name, ", ".join(unknown), valid)
            )
    if errors:
        raise ConfigError("\n".join(errors))
    return servers


def servers_for(servers: dict, target: str) -> dict:
    return {n: c for n, c in servers.items() if target in c["targets"]}


class Action:
    """One pending change. `apply` performs it."""

    def __init__(self, verb, detail, run):
        self.verb = verb
        self.detail = detail
        self._run = run

    def apply(self):
        self._run()

    def __str__(self):
        return "  %-6s %s" % (self.verb, self.detail)


class Plan:
    def __init__(self):
        self.actions = []

    def add(self, action):
        if action is not None:
            self.actions.append(action)

    def apply(self):
        for action in self.actions:
            action.apply()

    def render(self):
        return "\n".join(str(a) for a in self.actions)

    def __bool__(self):
        return bool(self.actions)


def write_file(path: Path, text: str):
    if path.exists():
        try:
            if path.read_text() == text:
                return None
        except (OSError, UnicodeDecodeError):
            pass

    def run():
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(text)

    return Action("write", str(path), run)


def claude_entries(servers: dict, home: Path) -> dict:
    out = {}
    for name in sorted(servers):
        cfg = servers[name]
        entry = {
            "type": "stdio",
            "command": resolve_command(cfg["command"], home),
            "args": list(cfg.get("args", [])),
        }
        if cfg.get("env"):
            entry["env"] = cfg["env"]
        out[name] = entry
    return out


def merge_claude_json(path: Path, text: str, servers: dict, managed, home: Path) -> str:
    """Merge ai-sync's servers into Claude Code's ~/.claude.json.

    Claude Code owns this file and rewrites it as it runs, so everything
    outside `mcpServers` is round-tripped untouched and entries inside it
    that ai-sync does not manage are left alone. `managed` is the server
    list from the previous run; an entry named there but no longer wanted
    is pruned, which is what stops a server removed from mcp.json from
    lingering forever.

    Claude Code writes this file with `json.dumps(indent=2,
    ensure_ascii=False)` and no trailing newline; matching that keeps the
    round trip byte-for-byte, so ai-sync reports no drift of its own.
    """
    if text.strip():
        try:
            data = json.loads(text)
        except json.JSONDecodeError as exc:
            raise ConfigError("%s is not valid JSON: %s" % (path, exc)) from exc
        if not isinstance(data, dict):
            raise ConfigError("%s: top level must be an object" % path)
    else:
        data = {}

    existing = data.get("mcpServers", {})
    if not isinstance(existing, dict):
        raise ConfigError("%s: 'mcpServers' must be an object" % path)

    wanted = claude_entries(servers, home)
    merged = {n: c for n, c in existing.items() if n in wanted or n not in managed}
    merged.update(wanted)

    if merged or "mcpServers" in data:
        data["mcpServers"] = merged

    out = json.dumps(data, indent=2, ensure_ascii=False)
    return out + "\n" if text.endswith("\n") else out


def write_claude_json(path: Path, servers: dict, managed, home: Path):
    """Plan the ~/.claude.json merge, recomputing it again at apply time.

    Claude Code may rewrite the file between planning and applying, so the
    merge is redone against what is on disk at apply time and swapped in
    with an atomic rename. That narrows the race to the rename itself; a
    Claude Code session running concurrently can still lose whichever
    write lands second, so prefer running ai-sync with Claude Code closed.
    """

    def read():
        try:
            return path.read_text()
        except FileNotFoundError:
            return ""
        except (OSError, UnicodeDecodeError) as exc:
            raise ConfigError("cannot read %s: %s" % (path, exc)) from exc

    current = read()
    if merge_claude_json(path, current, servers, managed, home) == current:
        return None

    def run():
        latest = read()
        text = merge_claude_json(path, latest, servers, managed, home)
        if text == latest:
            return
        path.parent.mkdir(parents=True, exist_ok=True)
        tmp = path.with_name(path.name + ".ai-sync.tmp")
        tmp.write_text(text)
        try:
            shutil.copymode(path, tmp)
        except OSError:
            tmp.chmod(0o600)
        os.replace(tmp, path)

    return Action("write", str(path), run)


def prune_legacy_claude_mcp(path: Path):
    """Drop ~/.claude/mcp.json, which Claude Code never reads.

    ai-sync used to write the Claude target here; the servers in it were
    silently inert. Only a file with ai-sync's own single-key shape is
    removed, so anything else parked at that path survives.
    """
    try:
        data = json.loads(path.read_text())
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        return None
    if not isinstance(data, dict) or set(data) != {"mcpServers"}:
        return None
    return unlink_action(path)


def split_jsonc(text: str):
    """Split leading // comments and blank lines from the JSON body."""
    lines = text.splitlines(keepends=True)
    index = 0
    while index < len(lines):
        stripped = lines[index].strip()
        if stripped == "" or stripped.startswith("//"):
            index += 1
            continue
        break
    return "".join(lines[:index]), "".join(lines[index:])


def resolve_command(command: str, home: Path) -> str:
    """Absolute path for `command`. GUI apps do not inherit shell PATH.

    Zed and the Claude Code desktop app both launch outside a login shell,
    so a bare `~/.local/bin` wrapper name would not resolve for them.

    Only those wrappers are resolved. Anything else keeps the bare name so
    it still resolves through PATH at launch: freezing today's answer would
    pin version-specific paths (a Homebrew `npx` lives under
    `/opt/homebrew/opt/node@NN/bin`) that break on the next upgrade.
    """
    if command.startswith("/"):
        return command
    local = home / ".local" / "bin" / command
    return str(local) if local.exists() else command


def render_zed(path: Path, text: str, servers: dict, home: Path) -> str:
    header, body = split_jsonc(text)
    try:
        data = json.loads(body)
    except json.JSONDecodeError as exc:
        raise ConfigError(
            "%s is not valid JSONC: %s\n"
            "ai-sync only supports comments in a leading header block, "
            "before the opening brace; comments after the opening brace "
            "and trailing commas are not supported there either. Move "
            "such comments into the leading header, or remove them."
            % (path, exc)
        ) from exc

    if servers:
        entries = {}
        for name in sorted(servers):
            cfg = servers[name]
            entry = {
                "command": resolve_command(cfg["command"], home),
                "args": list(cfg.get("args", [])),
            }
            if cfg.get("env"):
                entry["env"] = cfg["env"]
            entries[name] = entry
        data["context_servers"] = entries
    else:
        data.pop("context_servers", None)

    return header + json.dumps(data, indent=2) + "\n"


def link(path: Path, dest: Path):
    """Symlink `path` -> `dest`. Never destroys a real file."""
    if path.is_symlink():
        if Path(os.readlink(path)) == dest:
            return None
    elif path.exists():
        raise ConfigError(
            "%s exists and is not a symlink; move it aside "
            "(its content belongs in %s)" % (path, dest)
        )

    def run():
        path.parent.mkdir(parents=True, exist_ok=True)
        if path.is_symlink():
            path.unlink()
        elif path.exists():
            raise ConfigError(
                "%s exists and is not a symlink; move it aside "
                "(its content belongs in %s)" % (path, dest)
            )
        path.symlink_to(dest)

    return Action("link", "%s -> %s" % (path, dest), run)


def unlink_action(path: Path):
    def run():
        path.unlink()

    return Action("unlink", str(path), run)


def plan_codex_skills(plan: Plan, src: Path, home: Path, errors: list) -> None:
    skills_src = src / "skills"
    skills_dst = home / ".codex" / "skills"

    wanted = {}
    if skills_src.is_dir():
        for entry in sorted(skills_src.iterdir()):
            if entry.is_dir() and not entry.name.startswith("."):
                wanted[entry.name] = entry

    for name, source in wanted.items():
        try:
            plan.add(link(skills_dst / name, source))
        except ConfigError as exc:
            errors.append(str(exc))

    if not skills_dst.is_dir():
        return
    for entry in sorted(skills_dst.iterdir()):
        # Only ever remove symlinks this tool created.
        if not entry.is_symlink() or entry.name in wanted:
            continue
        try:
            points_into_src = Path(os.readlink(entry)).parent == skills_src
        except OSError:
            continue
        if points_into_src:
            plan.add(unlink_action(entry))


def state_dir() -> Path:
    override = os.environ.get("AI_SYNC_STATE")
    if override:
        return Path(override)
    base = os.environ.get("XDG_STATE_HOME")
    root = Path(base) if base else Path.home() / ".local" / "state"
    return root / "ai-sync"


def state_path() -> Path:
    return state_dir() / "managed.json"


def read_state() -> dict:
    try:
        data = json.loads(state_path().read_text())
    except (OSError, json.JSONDecodeError):
        return {}
    if not isinstance(data, dict):
        return {}
    for key in ("codex", "claude"):
        names = data.get(key)
        if not isinstance(names, list) or not all(isinstance(n, str) for n in names):
            data.pop(key, None)
    return data


def write_state(state: dict) -> None:
    path = state_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(state, indent=2, sort_keys=True) + "\n")


def codex_bin():
    """Resolve the Codex binary.

    An empty AI_SYNC_CODEX_BIN disables Codex sync outright (a deliberate
    opt-out; no note printed). A configured binary that cannot be found
    (not on PATH, or a bad absolute path) also disables Codex sync for
    this run, but prints one note to stderr explaining why, since that
    case is usually not deliberate.
    """
    value = os.environ.get("AI_SYNC_CODEX_BIN", "codex")
    if not value:
        return None
    resolved = shutil.which(value)
    if resolved is None:
        print(
            "ai-sync: codex binary %r not found; skipping Codex sync" % value,
            file=sys.stderr,
        )
        return None
    return resolved


def codex_installed(binary: str) -> set:
    try:
        proc = subprocess.run(
            [binary, "mcp", "list", "--json"],
            capture_output=True,
            text=True,
            check=False,
        )
    except OSError:
        return set()
    if proc.returncode != 0:
        return set()
    try:
        listed = json.loads(proc.stdout or "[]")
    except json.JSONDecodeError:
        return set()
    return {item["name"] for item in listed if isinstance(item, dict) and "name" in item}


def _codex_run(binary: str, args: list, name: str) -> None:
    """Run a codex CLI mutation. Defence in depth: codex_bin() already
    verifies the binary exists, but if it vanishes between plan and apply
    (or any other OSError fires), report which server failed instead of
    crashing and aborting the rest of the plan.
    """
    try:
        subprocess.run([binary] + args, check=False)
    except OSError as exc:
        print(
            "ai-sync: codex command for %r failed to run: %s" % (name, exc),
            file=sys.stderr,
        )


def plan_codex_mcp(plan: Plan, servers: dict, state: dict) -> list:
    binary = codex_bin()
    wanted = servers_for(servers, "codex")
    if binary is None:
        return sorted(state.get("codex", []))

    installed = codex_installed(binary)
    owned = set(state.get("codex", []))

    for name in sorted(wanted):
        cfg = wanted[name]
        if name in installed:
            continue
        args = ["mcp", "add", name]
        for key, value in sorted((cfg.get("env") or {}).items()):
            args += ["--env", "%s=%s" % (key, value)]
        args += ["--", cfg["command"]] + list(cfg.get("args", []))
        plan.add(
            Action(
                "codex",
                "+ %s" % name,
                lambda b=binary, a=args, n=name: _codex_run(b, a, n),
            )
        )

    # Only remove servers this tool installed. Never app-managed ones.
    for name in sorted(owned - set(wanted)):
        if name not in installed:
            continue
        plan.add(
            Action(
                "codex",
                "- %s" % name,
                lambda b=binary, n=name: _codex_run(b, ["mcp", "remove", n], n),
            )
        )

    return sorted(wanted)


def build_plan(servers):
    """Build the sync plan.

    Returns (plan, state, errors). `errors` collects link refusals (a real,
    non-symlink file or directory sitting where ai-sync needs to place a
    symlink) so one blocked path never prevents everything else in the
    plan from being built and applied. Genuine config errors (e.g. a
    malformed mcp.json or Zed settings.json) still raise ConfigError and
    abort plan construction entirely, since those are not safe to apply
    partially.
    """
    plan = Plan()
    home = target_home()
    src = ai_dir()
    state = read_state()
    errors = []

    def try_link(path, dest):
        try:
            plan.add(link(path, dest))
        except ConfigError as exc:
            errors.append(str(exc))

    claude_servers = servers_for(servers, "claude")
    plan.add(
        write_claude_json(
            home / ".claude.json", claude_servers, state.get("claude", []), home
        )
    )
    plan.add(prune_legacy_claude_mcp(home / ".claude" / "mcp.json"))
    state["claude"] = sorted(claude_servers)

    agents = src / "AGENTS.md"
    try_link(home / ".claude" / "skills", src / "skills")
    try_link(home / ".claude" / "CLAUDE.md", agents)
    try_link(home / ".codex" / "AGENTS.md", agents)
    try_link(home / ".claude" / "settings.json", src / "claude" / "settings.json")

    zed_settings = repo_root() / ".config" / "zed" / "settings.json"
    if zed_settings.exists():
        plan.add(
            write_file(
                zed_settings,
                render_zed(
                    zed_settings,
                    zed_settings.read_text(),
                    servers_for(servers, "zed"),
                    home,
                ),
            )
        )

    plan_codex_skills(plan, src, home, errors)
    new_codex = plan_codex_mcp(plan, servers, state)
    state["codex"] = new_codex
    return plan, state, errors


def main(argv):
    if "--help" in argv or "-h" in argv:
        print(USAGE)
        return 0
    if "--version" in argv:
        print(VERSION)
        return 0

    unknown = [a for a in argv if a != "--check"]
    if unknown:
        print("ai-sync: unknown argument: %s" % " ".join(unknown), file=sys.stderr)
        print(USAGE, file=sys.stderr)
        return 2

    check = "--check" in argv

    try:
        servers = load_servers(ai_dir())
        plan, state, errors = build_plan(servers)
    except ConfigError as exc:
        print("ai-sync: %s" % exc, file=sys.stderr)
        return 2

    plan_is_empty = not plan

    if plan_is_empty and not errors:
        if not check:
            write_state(state)
            print("ai-sync: already in sync")
        return 0

    if not plan_is_empty:
        print(plan.render())

    if check:
        for message in errors:
            print("ai-sync: %s" % message, file=sys.stderr)
        return 2 if errors else 1

    if not plan_is_empty:
        plan.apply()
    write_state(state)

    if errors:
        for message in errors:
            print("ai-sync: %s" % message, file=sys.stderr)
        return 2

    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
