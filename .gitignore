# macOS
.DS_Store

# Local Claude Code overrides
**/.claude/settings.local.json

# Zed local state (machine-specific, not config)
.config/zed/prompts/
.config/zed/conversations/

# Subagent-driven-development scratch
.superpowers/

# Python bytecode
__pycache__/

# Claude skill sync cache (account-specific, written through the skills symlink)
.config/ai/skills/synced/

# Tool dirs that also hold runtime state and credentials; only their config is
# tracked. Backstop for when stow folds a missing ~/.config/<tool> into the repo.
.config/herdr/*
!.config/herdr/config.toml
.config/television/*
!.config/television/config.toml
.config/gh/*
!.config/gh/config.yml

# gnupg keeps its private keys, keyring and trustdb here too; only the
# non-secret config files are tracked.
.config/gnupg/*
!.config/gnupg/gpg-agent.conf
!.config/gnupg/gpg.conf
