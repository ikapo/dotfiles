# A Mac that mostly runs agents over SSH: the CLI half of Brewfile, Xcode,
# Obsidian for the vault, and Ghostty, a browser and the agent apps for when it
# is used at the desk or over Screen Sharing. No editors or window management.
# Sign in to the App Store app first, as for Brewfile. Install with:
#   brew bundle --file=Brewfile.server
# README.md#headless-mac covers the rest of the setup. When a package here
# changes in Brewfile, change it here too.

tap "facebook/fb"

# VCS & dev tools
brew "gh"
brew "git"
brew "git-lfs"
brew "lazygit"
brew "stow"

# Languages & runtimes
# bun and uv are required by the claude-mem plugin (uv runs its Chroma search)
brew "bun"
brew "node@24"
brew "pnpm"
brew "uv"

# Editors & shell
brew "neovim"  # $EDITOR, for git and Claude Code's external editor
brew "zsh-autosuggestions"  # .zshrc sources both unconditionally
brew "zsh-syntax-highlighting"
brew "herdr"  # persistent agent sessions; attach with herdr --remote

# CLI utilities
brew "bat"
brew "fd"
brew "fzf"  # .zshrc runs fzf and zoxide unconditionally
brew "jq"
brew "lsd"
brew "ripgrep"
brew "zoxide"
brew "coreutils"
brew "gnu-sed"
brew "wget"
brew "mole"
brew "todoist-cli"  # the todoist-cli skill drives it
brew "skills"  # installs third-party agent skills; .config/ai/PLUGINS.md

# Mobile / iOS
brew "cocoapods"
brew "fastlane"
brew "facebook/fb/idb-companion"

# Misc
brew "mas"

# Browsers
cask "helium-browser"

# Dev
cask "ghostty"
cask "claude"
cask "claude-code@latest"
cask "grok-bot"
cask "grok-build"
cask "t3-code@nightly"

# Productivity
cask "obsidian"  # keeps the vault synced; README.md#headless-mac

# Fonts
cask "font-mononoki-nerd-font"  # Ghostty's font-family

# App Store — sign in to the App Store app first; mas cannot sign in.
mas "Xcode", id: 497799835
